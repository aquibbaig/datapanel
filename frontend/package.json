{
  "name": "datapanel-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "check:folding": "esbuild scripts/sqlFolding.check.ts --bundle --platform=node --format=esm --outfile=/tmp/datapanel-sql-folding-check.mjs && node /tmp/datapanel-sql-folding-check.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@replit/codemirror-vim": "^6.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-virtual": "^3.14.2",
    "cmdk": "^1.1.1",
    "codemirror-shiki": "^0.3.0",
    "lucide-react": "^0.468.0",
    "posthog-js": "^1.390.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.1.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  }
}
